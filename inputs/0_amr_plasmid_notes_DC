RUNNING abriTAMR for both acquired gene and point mutation resistance
Prepare species_samplesheet.csv using R to specify the species scheme for abriTAMR.

mkdir -p /srv/nfs_share/2026_ACORNHAI/inputs/output_abritamr; \
tail -n +2 /srv/nfs_share/2026_ACORNHAI/inputs/species_samplesheet.csv | \
while IFS=, read -r workAMR_fasta mlst abritamr_scheme; do \
	b=$(basename "$workAMR_fasta" .fastq.gz.long.fasta); \
	abritamr run --species "$abritamr_scheme" \
		--contigs "$workAMR_fasta"\
		--prefix /srv/nfs_share/2026_ACORNHAI/inputs/output_abritamr/"${b%.*}";
done

Rename abriTAMR result based on barcodes from previous folder:
for i in /srv/nfs_share/2026_ACORNHAI/inputs/output_abritamr/*/*; do
	folder_name=$(basename "$(dirname "$i")")
	b=$(basename "$i")
	mv "$i" "$(dirname "$i")/${folder_name}_${b}"
done


2. MLST typing
Prepare species_samplesheet.csv using R to specify the MLST scheme based on bacterial genus/species.

tail -n +2 /srv/nfs_share/2026_ACORNHAI/inputs/species_samplesheet.csv | \
while IFS=, read -r workAMR_fasta mlst_scheme amr; do \
	mlst --scheme "$mlst_scheme" \
		"$workAMR_fasta"; done > /srv/nfs_share/2026_ACORNHAI/inputs/mlst_all.tsv

