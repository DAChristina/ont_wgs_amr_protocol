1. Horizontal gene resistance (ABRicate)
Activate conda & abricate env. first.
Save database version used in ABRicate for this project as a text file in /inputs
abricate --list > /srv/nfs_share/2026_ACORNHAI/inputs/db_abricate

Compile all results in /<R project>/inputs folder

I modify ABRicate command into a reasonable one-liner (pardon my laziness B))
current_batch=2; \
ont_address="ACORN-HAI_BATCH2_5_06MAY26/ACORN-HAI_BATCH2_5_06MAY26/20260506_1543_X4_FBD04135_52f95109"; \
ABRICATE_VERSION=$(abricate --version 2>&1 | grep -oP '\d+\.\d+\.\d+'); \
mkdir -p /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}; \
mkdir -p /srv/nfs_share/2026_ACORNHAI/inputs/output_hamronized_batch${current_batch}; \
for i in /srv/nfs_share/2026_ACORNHAI/raw_data/"$ont_address"/output_ghru-mod_lambda_filter_on/assemblies/*.fastq.gz.long.fasta; do \
    b=$(basename "$i" .fastq.gz.long.fasta); \
    echo "WE'RE HERE: $b"; \
    for db in ncbi resfinder plasmidfinder vfdb; do \
        abricate --db "$db" "$i" > /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}/${b}_abricate_${db}.tab; \
        DB_VERSION=$(abricate --list | grep "^${db}" | awk '{print $4}'); \
        hamronize abricate \
            /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}/${b}_abricate_${db}.tab \
            --reference_database_version "$DB_VERSION" \
            --analysis_software_version  "$ABRICATE_VERSION" \
            --format tsv > /srv/nfs_share/2026_ACORNHAI/inputs/output_hamronized_batch${current_batch}/${b}_hamronized_${db}.tsv; \
    done; \
done; \
for db in ncbi resfinder plasmidfinder vfdb; do \
    abricate --summary /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}/*abricate_${db}.tab > /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}/abricate_${db}_batch${current_batch}_wide.tab; \
done; \
hamronize summarize /srv/nfs_share/2026_ACORNHAI/inputs/output_hamronized_batch${current_batch}/*_hamronized_*.tsv \
    --output /srv/nfs_share/2026_ACORNHAI/inputs/output_hamronized_batch${current_batch}/hamronized_summary.tsv \
    --summary_type tsv


