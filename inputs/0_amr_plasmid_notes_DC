1. Horizontal gene resistance (ABRicate)
Activate conda & abricate env. first.
Save database version used in ABRicate for this project as a text file in /inputs
abricate --list > /srv/nfs_share/2026_ACORNHAI/inputs/db_abricate

Compile all results in /<R project>/inputs folder

I modify ABRicate command into a reasonable one-liner (pardon my laziness B))
current_batch=2; \
ont_address="ACORN-HAI_BATCH2_5_06MAY26/ACORN-HAI_BATCH2_5_06MAY26/20260506_1543_X4_FBD04135_52f95109"; \
mkdir -p /srv/nfs_share/2026_ACORNHAI/raw_data/"$ont_address"/output_abricate; \
mkdir -p /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}; \
for i in /srv/nfs_share/2026_ACORNHAI/raw_data/"$ont_address"/output_ghru-mod_lambda_filter_on/assemblies/*.fastq.gz.long.fasta; do
	b=$(basename "$i" .fastq.gz.long.fasta); \
	echo "WE'RE HERE: $b"; \
		for db in ncbi resfinder plasmidfinder card vfdb; do
			abricate -db "$db" "$i" > /srv/nfs_share/2026_ACORNHAI/raw_data/"$ont_address"/output_abricate/"${b}_abricate_${db}.tab"; \
		done; \
done; \
cp /srv/nfs_share/2026_ACORNHAI/raw_data/"$ont_address"/output_abricate/* /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}/; \
for db in ncbi resfinder plasmidfinder card vfdb; do \
	abricate --summary /srv/nfs_share/2026_ACORNHAI/raw_data/"$ont_address"/output_abricate/*_abricate_${db}.tab > /srv/nfs_share/2026_ACORNHAI/inputs/output_abricate_batch${current_batch}/abricate_${db}_batch${current_batch}_wide.tab; \
done





